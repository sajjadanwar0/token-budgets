//! trybuild compile-fail test harness.
//!
//! If you already have `tests/compile_fail.rs` in your project,
//! KEEP YOUR EXISTING FILE and just drop the new `budget_mint_required.rs`
//! into the `tests/compile_fail/` directory. The existing glob
//! `t.compile_fail("tests/compile_fail/*.rs")` will pick it up.
//!
//! Only use this file if you don't already have a runner.

mod budget_mint_required;

#[test]
fn compile_fail_suite() {
    let t = trybuild::TestCases::new();
    t.compile_fail("tests/compile_fail/*.rs");
}